<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <Company>WssIDs</Company>
        <ApplicationIcon>main.ico</ApplicationIcon>
        <PackageIcon>main.ico</PackageIcon>
        <Authors>WssIDs</Authors>
        <Copyright>2026</Copyright>
        <IsPackable>false</IsPackable>
		<SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
        <NeutralLanguage>ru</NeutralLanguage>
    </PropertyGroup>
	<PropertyGroup>
		<FileVersion>1.3.2</FileVersion>
		<AssemblyVersion>1.3.2</AssemblyVersion>
		<ProductVersion>1.3.2</ProductVersion>
		<Version>1.3.2</Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
      <PackageReference Include="MahApps.Metro.IconPacks.Modern" Version="6.2.1" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
      <PackageReference Include="Meziantou.Framework.Win32.Dialogs" Version="4.0.7" />
      <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
      <PackageReference Include="ModernWpfUI" Version="1.0.0-rc.1" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<!-- Для записи в файл, если необходимо -->
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<!-- Для консоли/отладки, если необходимо -->
      <PackageReference Include="W.TrayIcon.WPF" Version="1.0.10" />
      <Resource Include="Images\logo.png" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="readme.md">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

	<Target Name="RemoveDuplicateConfigurationGenerator" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)" Condition="'%(FileName)' == 'Microsoft.Extensions.Configuration.Binder.SourceGeneration'" />
		</ItemGroup>
	</Target>

	<ItemGroup>
      <Page Update="Views\MainView.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="Views\NewVersionView.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <Resource Include="main.ico" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Properties\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\YandexClient\YandexDisk.API.Client.csproj" />
    </ItemGroup>

</Project>
